<div style="max-width: 1100px; margin: 0 auto; padding: 64px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start;">
  
  <!-- Left Poster Composition -->
  <div style="background: var(--ink-2); border: 1px solid var(--red-40); padding: 32px; text-align: center;" class="halftone-25 registration-mark">
    <img src="/assets/guardians/veil.svg" alt="VEIL" style="max-height: 280px; width: auto; margin-bottom: 16px;" />
    <div style="font-family: var(--font-data); font-size: 12px; color: var(--red-100); font-weight: 800;">
      GUARDIAN // VEIL
    </div>
    <div className="voice-italic" style="font-size: 16px; margin-top: 8px;">
      "Enroll your name in the master ledger of masterminds."
    </div>
  </div>

  <!-- Right Registration Form -->
  <div style="background: var(--ink-2); border: 1px solid var(--red-40); padding: 40px;" class="registration-mark">
    
    <div style="font-family: var(--font-data); font-size: 11px; color: var(--red-100); font-weight: 800; margin-bottom: 8px;">
      PARTICIPANT REGISTRATION
    </div>

    <h1 class="poster-m" style="color: var(--on-ink); margin: 0 0 24px 0;">CREATE SURVIVOR DOSSIER</h1>

    <% if (error) { %>
      <div style="background: var(--red-20); border: 1px solid var(--red-100); color: var(--red-100); padding: 12px; font-family: var(--font-data); font-size: 11px; margin-bottom: 20px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <form action="/register" method="post" style="space-y: 16px;">
      <input type="hidden" name="user_type" value="PARTICIPANT" />

      <div style="margin-bottom: 14px;">
        <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted); block; font-weight: 700; margin-bottom: 4px;">FULL NAME *</label>
        <input type="text" name="name" required placeholder="e.g. Priya Sundaram" style="width: 100%; background: var(--ink); border: 1px solid var(--red-40); color: var(--on-ink); padding: 10px 12px; font-family: var(--font-text);" />
      </div>

      <div style="margin-bottom: 14px;">
        <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted); block; font-weight: 700; margin-bottom: 4px;">EMAIL ADDRESS *</label>
        <input type="email" name="email" required placeholder="priya@psgtech.ac.in" style="width: 100%; background: var(--ink); border: 1px solid var(--red-40); color: var(--on-ink); padding: 10px 12px; font-family: var(--font-text);" />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
        <div>
          <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted); block; font-weight: 700; margin-bottom: 4px;">PHONE *</label>
          <input type="tel" name="phone" required placeholder="9876543210" style="width: 100%; background: var(--ink); border: 1px solid var(--red-40); color: var(--on-ink); padding: 10px 12px; font-family: var(--font-text);" />
        </div>
        <div>
          <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted); block; font-weight: 700; margin-bottom: 4px;">PASSWORD *</label>
          <input type="password" name="password" required placeholder="••••••••" style="width: 100%; background: var(--ink); border: 1px solid var(--red-40); color: var(--on-ink); padding: 10px 12px; font-family: var(--font-text);" />
        </div>
      </div>

      <div style="margin-bottom: 14px;">
        <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted); block; font-weight: 700; margin-bottom: 4px;">COLLEGE NAME *</label>
        <input type="text" name="college_name" required placeholder="PSG College of Technology" style="width: 100%; background: var(--ink); border: 1px solid var(--red-40); color: var(--on-ink); padding: 10px 12px; font-family: var(--font-text);" />
      </div>

      <button type="submit" style="width: 100%; background: var(--red); color: #FFF; border: none; padding: 14px; font-family: var(--font-data); font-size: 12px; font-weight: 800; cursor: pointer; text-transform: uppercase; margin-top: 12px;" class="misregister-hover">
        CREATE ACCOUNT & ENTER →
      </button>
    </form>

    <div style="border-top: 1px solid var(--red-40); margin-top: 20px; padding-top: 14px; text-align: center; font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted);">
      Already registered? <a href="/login" style="color: var(--red-100); text-decoration: none; font-weight: 800;">SIGN IN →</a>
    </div>
  </div>

</div>
