<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LOGIN 2026 — Initializing Command Sequence</title>
  <link rel="stylesheet" href="/css/print-system.css">
</head>
<body style="background: #000; color: #fff; margin: 0; padding: 0; height: 100vh; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">

  <!-- Full-bleed Video -->
  <video id="introVid" autoplay muted playsinline style="width: 100%; height: 100%; object-fit: cover;">
    <source src="/assets/intro.mp4" type="video/mp4">
  </video>

  <!-- Controls Overlay -->
  <div style="position: absolute; top: 24px; right: 24px; display: flex; gap: 16px; z-index: 20;">
    <button id="muteBtn" style="background: rgba(18, 7, 8, 0.8); color: #fff; border: 1px solid var(--red); padding: 8px 16px; font-family: var(--font-data); font-size: 11px; cursor: pointer;">
      UNMUTE AUDIO 🔊
    </button>
    <a href="/" style="background: var(--red); color: #fff; border: none; padding: 8px 24px; font-family: var(--font-data); font-size: 11px; font-weight: 800; text-decoration: none; text-transform: uppercase;" class="misregister-hover">
      SKIP INTRO ▶
    </a>
  </div>

  <!-- Bottom Readout -->
  <div style="position: absolute; bottom: 24px; left: 24px; font-family: var(--font-data); font-size: 11px; color: var(--on-ink-muted);">
    INITIALIZING FEST TELEMETRY · LOGIN 2026 · 35TH EDITION
  </div>

  <script>
    const video = document.getElementById('introVid');
    const muteBtn = document.getElementById('muteBtn');

    muteBtn.addEventListener('click', () => {
      video.muted = !video.muted;
      muteBtn.textContent = video.muted ? 'UNMUTE AUDIO 🔊' : 'MUTE AUDIO 🔇';
    });

    video.addEventListener('ended', () => {
      window.location.href = '/';
    });
  </script>
</body>
</html>
