<div style="max-width: 800px; margin: 0 auto; padding: 64px 24px;">
  
  <div style="background: var(--paper); color: var(--on-paper); padding: 48px; border: 1px solid var(--on-paper-muted);" class="registration-mark">
    <div style="font-family: var(--font-data); font-size: 11px; color: var(--red); font-weight: 800; letter-spacing: 0.14em;">
      PSG TECH MCA ALUMNI INVITATION
    </div>

    <h1 class="poster-l" style="color: var(--on-paper); margin: 12px 0 24px 0;">WELCOME HOME, ALUMNI</h1>

    <p style="font-family: var(--font-text); font-size: 14px; color: var(--on-paper-muted); line-height: 1.6; margin-bottom: 32px;">
      Reconnect with past batches, network with current students, and witness the 35th edition of LOGIN on 18 & 19 September 2026.
    </p>

    <form action="/register?type=alumni" method="post" style="space-y: 20px;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div>
          <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-paper); block; font-weight: 700; margin-bottom: 6px;">FULL NAME *</label>
          <input type="text" name="name" required placeholder="e.g. Ramesh Kumar" style="width: 100%; background: var(--paper-2); border: 1px solid var(--on-paper-muted); color: var(--on-paper); padding: 10px 14px; font-family: var(--font-text);" />
        </div>
        <div>
          <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-paper); block; font-weight: 700; margin-bottom: 6px;">EMAIL ADDRESS *</label>
          <input type="email" name="email" required placeholder="ramesh@alumni.psgtech.ac.in" style="width: 100%; background: var(--paper-2); border: 1px solid var(--on-paper-muted); color: var(--on-paper); padding: 10px 14px; font-family: var(--font-text);" />
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
        <div>
          <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-paper); block; font-weight: 700; margin-bottom: 6px;">BATCH YEAR *</label>
          <input type="text" name="batch_year" required placeholder="e.g. 2018-2021" style="width: 100%; background: var(--paper-2); border: 1px solid var(--on-paper-muted); color: var(--on-paper); padding: 10px 14px; font-family: var(--font-text);" />
        </div>
        <div>
          <label style="font-family: var(--font-data); font-size: 11px; color: var(--on-paper); block; font-weight: 700; margin-bottom: 6px;">ORGANIZATION / COMPANY</label>
          <input type="text" name="current_organization" placeholder="e.g. Microsoft / Zoho" style="width: 100%; background: var(--paper-2); border: 1px solid var(--on-paper-muted); color: var(--on-paper); padding: 10px 14px; font-family: var(--font-text);" />
        </div>
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" style="background: var(--red); color: #FFF; border: none; padding: 14px 28px; font-family: var(--font-data); font-size: 12px; font-weight: 800; cursor: pointer; text-transform: uppercase;" class="misregister-hover">
          SUBMIT ALUMNI REGISTRATION →
        </button>
      </div>
    </form>
  </div>

</div>
