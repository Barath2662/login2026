<% if (typeof announcements !== 'undefined' && announcements && announcements.length > 0) { %>
  <div style="background: var(--ink-2); border-bottom: 1px solid var(--red-70); color: var(--on-ink); font-family: var(--font-data); font-size: 11px; padding: 8px 16px; overflow: hidden; white-space: nowrap;">
    <div style="display: inline-block; animation: marquee 25s linear infinite;">
      <% announcements.forEach(function(a) { %>
        <span style="color: var(--red-100); font-weight: 800; margin-right: 8px;">[<%= a.title %>]</span>
        <span style="margin-right: 32px;"><%= a.message %></span>
      <% }); %>
    </div>
  </div>
<% } %>
