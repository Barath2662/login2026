<header style="background-color: var(--ink-2); border-bottom: 1px solid var(--red-40); padding: 16px 24px;">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
    
    <!-- Brand Mark -->
    <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--on-ink);" class="misregister-hover">
      <img src="/assets/logo.svg" alt="LOGIN 2026" style="height: 36px; width: auto;" />
      <div>
        <div style="font-family: var(--font-poster); font-weight: 800; font-size: 20px; tracking-widest;">
          LOGIN <span style="color: var(--red-100);">2026</span>
        </div>
        <div style="font-family: var(--font-data); font-size: 9px; color: var(--on-ink-muted); letter-spacing: 0.14em;">
          35TH EDITION · PSG TECH
        </div>
      </div>
    </a>

    <!-- Nav Links -->
    <nav style="display: flex; gap: 24px; font-family: var(--font-text); font-size: 14px; font-weight: 600;">
      <a href="/events" style="color: var(--on-ink); text-decoration: none;">EVENTS (11)</a>
      <a href="/timeline" style="color: var(--on-ink); text-decoration: none;">TIMELINE</a>
      <a href="/legacy" style="color: var(--on-ink); text-decoration: none;">LEGACY</a>
      <a href="/alumni" style="color: var(--on-ink); text-decoration: none;">ALUMNI</a>
      <a href="/contact" style="color: var(--on-ink); text-decoration: none;">CONTACT</a>
    </nav>

    <!-- Auth Actions (Server-side resolved role targets) -->
    <div style="display: flex; gap: 12px; align-items: center;">
      <% if (user) { %>
        <% if (user.role === 'admin' || user.role === 'admin_power') { %>
          <a href="/admin" style="background: var(--red); color: #fff; text-decoration: none; padding: 8px 16px; font-family: var(--font-data); font-size: 11px; font-weight: 700; text-transform: uppercase;" class="misregister-hover">
            ADMIN PANEL →
          </a>
        <% } else if (user.role === 'event_coordinator') { %>
          <a href="/coordinator" style="background: var(--red); color: #fff; text-decoration: none; padding: 8px 16px; font-family: var(--font-data); font-size: 11px; font-weight: 700; text-transform: uppercase;" class="misregister-hover">
            COORDINATOR DESK →
          </a>
        <% } else { %>
          <a href="/dashboard" style="background: var(--red); color: #fff; text-decoration: none; padding: 8px 16px; font-family: var(--font-data); font-size: 11px; font-weight: 700; text-transform: uppercase;" class="misregister-hover">
            DOSSIER [<%= user.name.slice(0, 10) %>]
          </a>
        <% } %>
        <form action="/logout" method="post" style="display: inline;">
          <button type="submit" style="background: transparent; color: var(--red-100); border: 1px solid var(--red-100); padding: 8px 12px; font-family: var(--font-data); font-size: 11px; font-weight: 700; cursor: pointer;">
            LOGOUT
          </button>
        </form>
      <% } else { %>
        <a href="/login" style="color: var(--on-ink); text-decoration: none; font-family: var(--font-data); font-size: 12px; font-weight: 700;">SIGN IN</a>
        <a href="/register" style="background: var(--red); color: #fff; text-decoration: none; padding: 8px 16px; font-family: var(--font-data); font-size: 11px; font-weight: 700; text-transform: uppercase;" class="misregister-hover">
          REGISTER NOW →
        </a>
      <% } %>
    </div>

  </div>
</header>
